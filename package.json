{
  "name": "vidgrab",
  "version": "0.1.0",
  "private": true,
  "description": "Télécharge les vidéos d'une page ou de tout un site (yt-dlp + crawler + navigateur).",
  "type": "module",
  "bin": {
    "vidgrab": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "grab": "node src/cli.js",
    "setup": "node scripts/setup.js --force",
    "postinstall": "node scripts/setup.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.1"
  }
}
